  DWORD cntRects = { 0x00000001 };
  DWORD rgnSize  = { 0x00000010 };
  RECTL rgnBounds;
} REGIONDATAHEADER;

/** 2.2.24 RegionData Object
 * https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/e66601f2-9b5c-4619-8476-ddb7b087551b
