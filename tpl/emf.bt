/** 2.2.25 RegionDataHeader Object
 * https://docs.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/5ca68a15-1811-45b6-a51b-5e40d1055ccc
 */
typedef struct tagREGIONDATAHEADER {
  DWORD nSize    = { 0x00000020 };
