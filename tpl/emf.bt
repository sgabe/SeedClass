  DWORD xSrc;
  DWORD ySrc;
  XFORM xformSrc;
  DWORD BkColorSrc;
  DWORD iUsageSrc;
  DWORD offBmiSrc = { emrSize };
  DWORD cbBmiSrc = { bmiSize };
  DWORD offBitsSrc = { 0x0000008c };
  DWORD cbBitsSrc;
  BITMAPINFO bmi;

  local int64 recordSize = FTell() - recordStart;
