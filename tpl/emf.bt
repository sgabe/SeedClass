/** 2.3.5.12 EMR_GRADIENTFILL
 * https://docs.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/1a3849c8-be6c-4d30-b5d3-f43b4c70ca0d
 */
typedef struct tagEMRGRADIENTFILL {
  local int64 recordStart = FTell();
  DWORD iType = { 0x00000076 };
  DWORD nSize;
  RECTL rclBounds;
  DWORD nVer = { 2 };
  DWORD nTri = { 1 };
  GradientFill ulMode = { GRADIENT_FILL_RECT_H, GRADIENT_FILL_RECT_V };
  TRIVERTEX vertices[nVer];
  GRADIENT_RECT rectangles[nTri];
  DWORD vertexPadding[nTri];

  local int64 recordSize = FTell() - recordStart;
  local uint paddingSize = Align4(recordSize) - recordSize;
  BYTE EmrAlignmentPadding[paddingSize];
  local int64 recordEnd = FTell();
  AssertValidEmfRecordSize(recordEnd - recordStart);
