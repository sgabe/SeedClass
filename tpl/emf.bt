  FSeek(recordEnd);
} EMRCOMMENT;

// https://docs.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/929b78e1-b848-44a5-9fac-327cae5c2ae5
typedef struct tagEMRCOMMENTEMFPLUS_EOF {
  local int64 recordStart = FTell();
  DWORD iType = { 0x00000046 };
  DWORD nSize;
  DWORD DataSize = { 0x00000010 };
  DWORD CommentIdentifier = { 0x2B464D45 }; // "EMF+"

  WORD  EmfPlusType  = { 0x4002 }; // EmfPlusEndOfFile
  WORD  EmfPlusFlags = { 0x0000 };
  DWORD EmfPlusSize  = { 0x0000000C };
  DWORD EmfPlusDataSize = { 0x00000000 };

  local int64 recordSize = FTell() - recordStart;
  local uint paddingSize = Align4(recordSize) - recordSize;
  BYTE EmrAlignmentPadding[paddingSize];
  local int64 recordEnd = FTell();
  AssertValidEmfRecordSize(recordEnd - recordStart);
  FSeek(recordStart + 4);
  local int previousEvilState = SetEvilBit(false);
  DWORD nSize = { (DWORD)(recordEnd - recordStart) };
  SetEvilBit(previousEvilState);
  FSeek(recordEnd);
} EMRCOMMENTEMFPLUS_EOF;

