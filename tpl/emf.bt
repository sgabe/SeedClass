/** 2.2.22 PixelFormatDescriptor Object
 * https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/1db036d6-2da8-4b92-b4f8-e9cab8cc93b7
 */
typedef struct tagPIXELFORMATDESCRIPTOR {
  local int previousConstantEvilState = SetEvilBit(false);
  WORD nSize = { 0x0028 };
  WORD nVersion = { 0x0001 };
  DWORD dwFlags = { 0x00000025 }; // DOUBLEBUFFER | DRAW_TO_WINDOW | SUPPORT_OPENGL
  BYTE iPixelType = { 0x00 };     // PFD_TYPE_RGBA
  BYTE cColorBits = { 24 };
  BYTE cRedBits = { 8 };
  BYTE cRedShift = { 16 };
  BYTE cGreenBits = { 8 };
  BYTE cGreenShift = { 8 };
  BYTE cBlueBits = { 8 };
  BYTE cBlueShift = { 0 };
  BYTE cAlphaBits = { 8 };
  BYTE cAlphaShift = { 24 };
  BYTE cAccumBits = { 0 };
  BYTE cAccumRedBits = { 0 };
  BYTE cAccumGreenBits = { 0 };
  BYTE cAccumBlueBits = { 0 };
  BYTE cAccumAlphaBits = { 0 };
  BYTE cDepthBits = { 24 };
  BYTE cStencilBits = { 8 };
  BYTE cAuxBuffers = { 0 };
  BYTE iLayerType = { 0 };
  BYTE bReserved = { 0 };
  DWORD dwLayerMask = { 0 };
  DWORD dwVisibleMask = { 0 };
  DWORD dwDamageMask = { 0 };
  SetEvilBit(previousConstantEvilState);
} PIXELFORMATDESCRIPTOR;

/** 2.2.26 TriVertex Object
 * https://docs.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/33578509-8349-46b6-8f8f-107c3f70bace
 */
typedef struct _TRIVERTEX {
