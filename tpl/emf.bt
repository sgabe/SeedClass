  local int previousEvilState = SetEvilBit(false);
  DWORD nSize = { (DWORD)(recordEnd - recordStart) };
  SetEvilBit(previousEvilState);
  FSeek(recordEnd);
} EMRSETTEXTJUSTIFICATION;

/** 11.28 EMR_SETVIEWPORTEXTEX Record
 * https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/a71486a3-9ebd-43e3-819f-5318a58b70d5
 */
typedef struct tagEMRSETVIEWPORTEXTEX {
  local int64 recordStart = FTell();
  DWORD iType = { 0x0000000b };
  DWORD	nSize;
  SIZEL szlExtent;

  local int64 recordSize = FTell() - recordStart;
  local uint paddingSize = Align4(recordSize) - recordSize;
  BYTE EmrAlignmentPadding[paddingSize];
  local int64 recordEnd = FTell();
  AssertValidEmfRecordSize(recordEnd - recordStart);
  FSeek(recordStart + 4);
  local int previousEvilState = SetEvilBit(false);
  DWORD nSize = { (DWORD)(recordEnd - recordStart) };
  SetEvilBit(previousEvilState);
  FSeek(recordEnd);
} EMRSETVIEWPORTEXTEX;

/** 11.29 EMR_SETVIEWPORTORGEX Record
 * https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/b8948947-3f8d-4add-a4b8-e572e8f90506
 */
typedef struct tagEMRSETVIEWPORTORGEX {
  local int64 recordStart = FTell();
  DWORD iType = { 0x0000000c};
  DWORD	nSize;
  POINTL ptlOrigin;

  local int64 recordSize = FTell() - recordStart;
  local uint paddingSize = Align4(recordSize) - recordSize;
  BYTE EmrAlignmentPadding[paddingSize];
  local int64 recordEnd = FTell();
  AssertValidEmfRecordSize(recordEnd - recordStart);
  FSeek(recordStart + 4);
  local int previousEvilState = SetEvilBit(false);
  DWORD nSize = { (DWORD)(recordEnd - recordStart) };
  SetEvilBit(previousEvilState);
  FSeek(recordEnd);
} EMRSETVIEWPORTORGEX;

/** 11.30 EMR_SETWINDOWEXTEX Record
 * https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/19521483-60b5-49b8-b58c-4b5d1b6cf839
 */
typedef struct tagEMRSETWINDOWEXTEX {
  local int64 recordStart = FTell();
  DWORD iType = { 0x00000009 };
  DWORD	nSize;
  SIZEL szlExtent;

  local int64 recordSize = FTell() - recordStart;
  local uint paddingSize = Align4(recordSize) - recordSize;
  BYTE EmrAlignmentPadding[paddingSize];
  local int64 recordEnd = FTell();
  AssertValidEmfRecordSize(recordEnd - recordStart);
  FSeek(recordStart + 4);
  local int previousEvilState = SetEvilBit(false);
  DWORD nSize = { (DWORD)(recordEnd - recordStart) };
  SetEvilBit(previousEvilState);
  FSeek(recordEnd);
} EMRSETWINDOWEXTEX;

/** 11.31 EMR_SETWINDOWORGEX Record
 * https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/952803a9-3d5c-4c83-a258-558bc1123bdb
 */
typedef struct tagEMRSETWINDOWORGEX {
  local int64 recordStart = FTell();
  DWORD iType = { 0x0000000a };
  DWORD	nSize;
  POINTL ptlOrigin;

  local int64 recordSize = FTell() - recordStart;
  local uint paddingSize = Align4(recordSize) - recordSize;
  BYTE EmrAlignmentPadding[paddingSize];
  local int64 recordEnd = FTell();
  AssertValidEmfRecordSize(recordEnd - recordStart);
  FSeek(recordStart + 4);
  local int previousEvilState = SetEvilBit(false);
  DWORD nSize = { (DWORD)(recordEnd - recordStart) };
  SetEvilBit(previousEvilState);
  FSeek(recordEnd);
} EMRSETWINDOWORGEX;


//------------------------------------------------
// 12. Transform Record Types
//------------------------------------------------



/** 2.3.12.1 EMR_MODIFYWORLDTRANSFORM Record
 * https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/c70b85e5-8c31-418f-a7b8-349e417e0f76
 */
typedef struct tagEMRMODIFYWORLDTRANSFORM {
  local int64 recordStart = FTell();
  DWORD iType = { 0x00000024 };
  DWORD nSize;
  XFORM Xform;
  local int previousModeEvilState = SetEvilBit(false);
  ModifyWorldTransformMode ModifyWorldTransformMode;
  SetEvilBit(previousModeEvilState);

  local int64 recordSize = FTell() - recordStart;
  local uint paddingSize = Align4(recordSize) - recordSize;
  BYTE EmrAlignmentPadding[paddingSize];
  local int64 recordEnd = FTell();
  AssertValidEmfRecordSize(recordEnd - recordStart);
  FSeek(recordStart + 4);
  local int previousEvilState = SetEvilBit(false);
  DWORD nSize = { (DWORD)(recordEnd - recordStart) };
  SetEvilBit(previousEvilState);
  FSeek(recordEnd);
} EMRMODIFYWORLDTRANSFORM;

/** 12.2 EMR_SETWORLDTRANSFORM Record
 * https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/985724c0-4db1-48f0-b346-67288b3288cb
 */
typedef struct tagEMRSETWORLDTRANSFORM {
  local int64 recordStart = FTell();
  DWORD iType = { 0x00000023 };
  DWORD	nSize;
  XFORM Xform;

  local int64 recordSize = FTell() - recordStart;
  local uint paddingSize = Align4(recordSize) - recordSize;
  BYTE EmrAlignmentPadding[paddingSize];
  local int64 recordEnd = FTell();
  AssertValidEmfRecordSize(recordEnd - recordStart);
  FSeek(recordStart + 4);
  local int previousEvilState = SetEvilBit(false);
  DWORD nSize = { (DWORD)(recordEnd - recordStart) };
  SetEvilBit(previousEvilState);
  FSeek(recordEnd);
} EMRSETWORLDTRANSFORM;


//------------------------------------------------

local DWORD supportedRecordTypes[] = {
  EMR_POLYBEZIER,
  EMR_POLYGON,
  EMR_POLYLINE,
  EMR_POLYBEZIERTO,
  EMR_POLYLINETO,
  EMR_POLYPOLYLINE,
  EMR_POLYPOLYGON,
  EMR_SETWINDOWEXTEX,
  EMR_SETWINDOWORGEX,
  EMR_SETVIEWPORTEXTEX,
  EMR_SETVIEWPORTORGEX,
  EMR_SETBRUSHORGEX,
  EMR_SCALEVIEWPORTEXTEX,
  EMR_SCALEWINDOWEXTEX,
  EMR_SETWORLDTRANSFORM,
  EMR_MODIFYWORLDTRANSFORM,
  EMR_SETPIXELV,
  EMR_SETMAPPERFLAGS,
  EMR_SETMAPMODE,
  EMR_SETBKMODE,
  EMR_SETROP2,
  EMR_SETICMMODE,
  EMR_SETLAYOUT,
  EMR_SETTEXTJUSTIFICATION,
  EMR_SETMITERLIMIT,
  EMR_SETPOLYFILLMODE,
  EMR_SETSTRETCHBLTMODE,
  EMR_SETTEXTALIGN,
  EMR_SETTEXTCOLOR,
  EMR_SETBKCOLOR,
  EMR_OFFSETCLIPRGN,
  EMR_SETMETARGN,
  EMR_MOVETOEX,
  EMR_EXCLUDECLIPRECT,
  EMR_INTERSECTCLIPRECT,
  EMR_SAVEDC,
  EMR_SELECTOBJECT,
  EMR_BEGINPATH,
  EMR_PIXELFORMAT,
  EMR_ANGLEARC,
  EMR_ELLIPSE,
  EMR_RECTANGLE,
  EMR_ROUNDRECT,
  EMR_ARC,
  EMR_CHORD,
  EMR_PIE,
  EMR_SELECTPALETTE,
  EMR_REALIZEPALETTE,
  EMR_EXTFLOODFILL,
  EMR_EXTTEXTOUTW,
  EMR_LINETO,
  EMR_POLYBEZIER16,
  EMR_POLYGON16,
  EMR_POLYLINE16,
  EMR_POLYBEZIERTO16,
  EMR_POLYLINETO16,
  EMR_POLYPOLYLINE16,
  EMR_POLYPOLYGON16,
  EMR_POLYDRAW16,
  EMR_ARCTO,
  EMR_SETARCDIRECTION,
  EMR_COMMENT,
  EMR_INVERTRGN,
  EMR_PAINTRGN,
  EMR_EXTSELECTCLIPRGN,
  EMR_STRETCHDIBITS,
  EMR_DRAWESCAPE,
  EMR_EXTESCAPE,
  EMR_GRADIENTFILL
};

LittleEndian();

// Add EMF_HEADER record.
EMRHEADER EmfHeader;
local int64 fixedHeaderEnd = FTell();
local int64 headerEnd = EmfHeader.nSize;

if (headerEnd < fixedHeaderEnd) {
  Warning( "EMR_HEADER size is smaller than its fixed fields." );
  return -1;
}
if ((headerEnd & 3) != 0) {
  Warning( "EMR_HEADER size is not DWORD-aligned." );
  return -1;
}

// Check for EMF signature.
if (EmfHeader.dSignature != 0x464D4520) {
  Warning( "File is not an enhanced metafile. Template stopped." );
  return -1;
}

if (EmfHeader.nDescription) {
  if (EmfHeader.offDescription) {
    local int64 descriptionStart = EmfHeader.offDescription;
    local int64 descriptionChars = EmfHeader.nDescription;
    local int64 descriptionSize = descriptionChars * 2;
    local int64 descriptionEnd = descriptionStart + descriptionSize;
    if (descriptionStart < fixedHeaderEnd) {
      Warning( "Description starts inside the fixed EMR_HEADER fields." );
      return -1;
    }
    if (descriptionEnd > headerEnd) {
      Warning( "Description extends beyond the EMR_HEADER record." );
      return -1;
    }
    FSeek(descriptionStart);
    EMRDESCRIPTION EmfDescription;
  }
}

if (EmfHeader.EmfHeaderExtension1.cbPixelFormat) {
  if (EmfHeader.EmfHeaderExtension1.offPixelFormat) {
    local int64 pixelFormatStart =
        EmfHeader.EmfHeaderExtension1.offPixelFormat;
    local int64 pixelFormatSize =
        EmfHeader.EmfHeaderExtension1.cbPixelFormat;
    local int64 pixelFormatEnd = pixelFormatStart + pixelFormatSize;
    if (pixelFormatStart < fixedHeaderEnd) {
      Warning( "Pixel-format data starts inside the fixed EMR_HEADER fields." );
      return -1;
    }
    if (pixelFormatEnd > headerEnd) {
      Warning( "Pixel-format data extends beyond the EMR_HEADER record." );
      return -1;
    }
  }
}

FSeek(headerEnd);

if (EmfHeader.nRecords < 2) {
  Warning( "EMF record count must include EMR_HEADER and EMR_EOF." );
  return -1;
}
if (IsParsing()) {
  Assert(EmfHeader.nRecords <= FileSize() / 8,
         "EMF record count cannot exceed the number of minimum-size records in the file.");
}

// Compound body items advance the count for every record they emit.
local uint recCnt = 0;
for (recCnt = 0; recCnt < EmfHeader.nRecords - 2; recCnt++) {
  local DWORD recordType = 0;
  if (IsParsing()) {
    // Parse existing records independently, including sequence continuation records.
    recordType = ReadUInt(FTell());
  } else {
    local int previousRecordTypeEvilState = SetEvilBit(false);
    DWORD generatedRecordType <values=supportedRecordTypes>;
    FSkip(-4);
    recordType = ReadUInt(FTell(), supportedRecordTypes);
    SetEvilBit(previousRecordTypeEvilState);
  }

  if (recordType == EMR_POLYBEZIER) {
    EMRPOLYBEZIER PolyBezier;

  } else if (recordType == EMR_POLYGON) {
    EMRPOLYGON Polygon;

  } else if (recordType == EMR_POLYLINE) {
    EMRPOLYLINE Polyline;

  } else if (recordType == EMR_POLYBEZIERTO) {
    EMRPOLYBEZIERTO PolyBezierTo;

  } else if (recordType == EMR_POLYLINETO) {
    EMRPOLYLINETO PolylineTo;

  } else if (recordType == EMR_POLYPOLYLINE) {
    EMRPOLYPOLYLINE PolyPolyline;

  } else if (recordType == EMR_POLYPOLYGON) {
    EMRPOLYPOLYGON PolyPolygon;

  } else if (recordType == EMR_SETWINDOWEXTEX) {
    EMRSETWINDOWEXTEX SetWindowExtEx;

  } else if (recordType == EMR_SETWINDOWORGEX) {
    EMRSETWINDOWORGEX SetWindowOrgEx;

  } else if (recordType == EMR_SETVIEWPORTEXTEX) {
    EMRSETVIEWPORTEXTEX SetViewportExtEx;

  } else if (recordType == EMR_SETVIEWPORTORGEX) {
    EMRSETVIEWPORTORGEX SetViewportOrgEx;

  } else if (recordType == EMR_SETBRUSHORGEX) {
    EMRSETBRUSHORGEX SetBrushOrgEx;

  } else if (recordType == EMR_SCALEVIEWPORTEXTEX) {
    EMRSCALEVIEWPORTEXTEX ScaleViewportExtEx;

  } else if (recordType == EMR_SCALEWINDOWEXTEX) {
    EMRSCALEWINDOWEXTEX ScaleWindowExtEx;

  } else if (recordType == EMR_SETPIXELV) {
    EMRSETPIXELV SetPixelV;

  } else if (recordType == EMR_SETMAPPERFLAGS) {
    EMRSETMAPPERFLAGS SetMapperFlags;

  } else if (recordType == EMR_SETMAPMODE) {
    EMRSETMAPMODE SetMapMode;

  } else if (recordType == EMR_SETBKMODE) {
    EMRSETBKMODE SetBkMode;

  } else if (recordType == EMR_SETPOLYFILLMODE) {
    EMRSETPOLYFILLMODE SetPolyFillMode;

  } else if (recordType == EMR_SETROP2) {
    EMRSETROP2 SetRop2;

  } else if (recordType == EMR_SETSTRETCHBLTMODE) {
    EMRSETSTRETCHBLTMODE SetStretchMode;

  } else if (recordType == EMR_SETTEXTALIGN) {
    EMRSETTEXTALIGN SetTextAlign;

  } else if (recordType == EMR_SETTEXTCOLOR) {
    EMRSETTEXTCOLOR SetTextColor;

  } else if (recordType == EMR_SETTEXTJUSTIFICATION) {
    EMRSETTEXTJUSTIFICATION SetTextJustification;

  } else if (recordType == EMR_SETBKCOLOR) {
    EMRSETBKCOLOR SetBkColor;

  } else if (recordType == EMR_OFFSETCLIPRGN) {
    EMROFFSETCLIPRGN OffsetClipRgn;

  } else if (recordType == EMR_SETMETARGN) {
    EMRSETMETARGN SetMetaRgn;

  } else if (recordType == EMR_MOVETOEX) {
    EMRMOVETOEX MoveToEx;

  } else if (recordType == EMR_EXCLUDECLIPRECT) {
    EMREXCLUDECLIPRECT ExcludeClipRect;

  } else if (recordType == EMR_INTERSECTCLIPRECT) {
    EMRINTERSECTCLIPRECT InterSectClipRect;

  } else if (recordType == EMR_SAVEDC) {
    local int previousSequenceEvilState = SetEvilBit(false);
    EMRSAVEDC SaveDC;
    if (IsParsing()) {
      // Following input records are handled separately by the dispatcher.
    } else {
      // Keep standalone and nested saves available as well as short restore cases.
      if (Random(2)) {
        EMRSETBKCOLOR SavedBackgroundColor;
        EMRRESTOREDC RestoreSavedDC;
        recCnt += 2;
      }
    }
    SetEvilBit(previousSequenceEvilState);

  } else if (recordType == EMR_RESTOREDC) {
    EMRRESTOREDC RestoreDC;

  } else if (recordType == EMR_SETWORLDTRANSFORM) {
    EMRSETWORLDTRANSFORM SetWorldTranform;

  } else if (recordType == EMR_MODIFYWORLDTRANSFORM) {
    EMRMODIFYWORLDTRANSFORM ModifyWorldTransform;

  } else if (recordType == EMR_SELECTOBJECT) {
    EMRSELECTOBJECT SelectObject;

  } else if (recordType == EMR_CREATEPEN) {
    EMRCREATEPEN CreatePen;

  } else if (recordType == EMR_CREATEBRUSHINDIRECT) {
    EMRCREATEBRUSHINDIRECT CreateBrushIndirect;

  } else if (recordType == EMR_DELETEOBJECT) {
    EMRDELETEOBJECT DeleteObject;

  } else if (recordType == EMR_PIXELFORMAT) {
    EMRPIXELFORMAT PixelFormat;

  } else if (recordType == EMR_ANGLEARC) {
    EMRANGLEARC AngleArc;

  } else if (recordType == EMR_ELLIPSE) {
    EMRELLIPSE Ellipse;

  } else if (recordType == EMR_RECTANGLE) {
    EMRRECTANGLE Rectangle;

  } else if (recordType == EMR_ROUNDRECT) {
    EMRROUNDRECT RoundRect;

  } else if (recordType == EMR_ARC) {
    EMRARC Arc;

  } else if (recordType == EMR_CHORD) {
    EMRCHORD Chord;

  } else if (recordType == EMR_PIE) {
    EMRPIE Pie;

  } else if (recordType == EMR_SELECTPALETTE) {
    EMRSELECTPALETTE SelectPalette;

  } else if (recordType == EMR_CREATEPALETTE) {
    EMRCREATEPALETTE CreatePalette;

  } else if (recordType == EMR_SETPALETTEENTRIES) {
    EMRSETPALETTEENTRIES SetPaletteEntries;

  } else if (recordType == EMR_RESIZEPALETTE) {
    EMRRESIZEPALETTE ResizePalette;

  } else if (recordType == EMR_REALIZEPALETTE) {
    EMRREALIZEPALETTE RealizePalette;

  } else if (recordType == EMR_EXTFLOODFILL) {
    EMREXTFLOODFILL ExtFloodFill;

  } else if (recordType == EMR_LINETO) {
    EMRLINETO LineTo;

  } else if (recordType == EMR_ARCTO) {
    EMRARCTO ArcTo;

  } else if (recordType == EMR_SETARCDIRECTION) {
    EMRSETARCDIRECTION SetArcDirection;

  } else if (recordType == EMR_POLYDRAW) {
    EMRPOLYDRAW PolyDraw;

  } else if (recordType == EMR_SETMITERLIMIT) {
    EMRSETMITERLIMIT SetMiterLimit;

  } else if (recordType == EMR_SETICMMODE) {
    EMRSETICMMODE SetIcmMode;

  } else if (recordType == EMR_SETLAYOUT) {
    EMRSETLAYOUT SetLayout;

  } else if (recordType == EMR_BEGINPATH) {
    local int previousPathSequenceEvilState = SetEvilBit(false);
    EMRBEGINPATH BeginPath;
    if (IsParsing()) {
      // Parse the path geometry and completion records on subsequent iterations.
    } else {
      EMRRECTANGLE PathRectangle;
      EMRENDPATH EndRectanglePath;

      // A completed path is consumed exactly once, by filling or stroking it.
      local DWORD pathPaintRecordTypes[] = { EMR_FILLPATH, EMR_STROKEPATH };
      DWORD generatedPathPaintType <values=pathPaintRecordTypes>;
      FSkip(-4);
      local DWORD pathPaintType = ReadUInt(FTell(), pathPaintRecordTypes);
      if (pathPaintType == EMR_FILLPATH) {
        EMRFILLPATH FillRectanglePath;
      } else {
        EMRSTROKEPATH StrokeRectanglePath;
      }
      recCnt += 3;
    }
    SetEvilBit(previousPathSequenceEvilState);

  } else if (recordType == EMR_ENDPATH) {
    EMRENDPATH EndPath;

  } else if (recordType == EMR_CLOSEFIGURE) {
    EMRCLOSEFIGURE CloseFigure;

  } else if (recordType == EMR_FILLPATH) {
    EMRFILLPATH FillPath;

  } else if (recordType == EMR_STROKEANDFILLPATH) {
    EMRSTROKEANDFILLPATH FillPath;

  } else if (recordType == EMR_STROKEPATH) {
    EMRSTROKEPATH StrokePath;

  } else if (recordType == EMR_FLATTENPATH) {
    EMRFLATTENPATH FlattenPath;

  } else if (recordType == EMR_WIDENPATH) {
    EMRWIDENPATH WidenPath;

  } else if (recordType == EMR_SELECTCLIPPATH) {
    EMRSELECTCLIPPATH SelectClipPath;

  } else if (recordType == EMR_ABORTPATH) {
    EMRABORTPATH AbortPath;

  } else if (recordType == EMR_COMMENT) {
    EMRCOMMENT Comment;

  } else if (recordType == EMR_FILLRGN) {
    EMRFILLRGN FillRgn;

  } else if (recordType == EMR_FRAMERGN) {
    EMRFRAMERGN FrameRgn;

  } else if (recordType == EMR_INVERTRGN) {
    EMRINVERTRGN InvertRgn;

  } else if (recordType == EMR_PAINTRGN) {
    EMRPAINTRGN PaintRgn;

  } else if (recordType == EMR_EXTSELECTCLIPRGN) {
    EMREXTSELECTCLIPRGN ExtSelectClipRgn;

  } else if (recordType == EMR_BITBLT) {
    EMRBITBLT BitBlt;

  } else if (recordType == EMR_STRETCHBLT) {
    EMRSTRETCHBLT StretchBlt;

  } else if (recordType == EMR_MASKBLT) {
    EMRMASKBLT MaskBlt;

  } else if (recordType == EMR_PLGBLT) {
    EMRPLGBLT PlgBlt;

  } else if (recordType == EMR_SETDIBITSTODEVICE) {
    EMRSETDIBITSTODEVICE SetDiBitsToDevice;

  } else if (recordType == EMR_STRETCHDIBITS) {
    EMRSTRETCHDIBITS StretchDIBits;

  } else if (recordType == EMR_EXTTEXTOUTA) {
    EMREXTTEXTOUTA ExtTextOutA;

  } else if (recordType == EMR_EXTTEXTOUTW) {
    EMREXTTEXTOUTW ExtTextOutW;

  } else if (recordType == EMR_POLYBEZIER16) {
    EMRPOLYBEZIER16 PolyBezier16;

  } else if (recordType == EMR_POLYGON16) {
    EMRPOLYGON16 Polygon16;

  } else if (recordType == EMR_POLYLINE16) {
    EMRPOLYLINE16 Polyline16;

  } else if (recordType == EMR_POLYBEZIERTO16) {
    EMRPOLYBEZIERTO16 PolyBezierTo16;

  } else if (recordType == EMR_POLYLINETO16) {
    EMRPOLYLINETO16 PolylineTo16;

  } else if (recordType == EMR_POLYPOLYLINE16) {
    EMRPOLYPOLYLINE16 PolyPolyline16;

  } else if (recordType == EMR_POLYPOLYGON16) {
    EMRPOLYPOLYGON16 PolyPolygon16;

  } else if (recordType == EMR_POLYDRAW16) {
    EMRPOLYDRAW16 PolyDraw16;

  } else if (recordType == EMR_CREATEMONOBRUSH) {
    EMRCREATEMONOBRUSH CreateMonoBrush;

  } else if (recordType == EMR_CREATEDIBPATTERNBRUSHPT) {
    EMRCREATEDIBPATTERNBRUSHPT CreateDIBPatternBrushPt;

  } else if (recordType == EMR_EXTCREATEPEN) {
    EMREXTCREATEPEN CreatePenEx;

  } else if (recordType == EMR_POLYTEXTOUTA) {
    EMRPOLYTEXTOUTA PolyTextOutA;

  } else if (recordType == EMR_CREATECOLORSPACE) {
    EMRCREATECOLORSPACE CreateColorSpace;

  } else if (recordType == EMR_SETCOLORSPACE) {
    EMRSETCOLORSPACE SetColorSpace;

  } else if (recordType == EMR_DELETECOLORSPACE) {
    EMRDELETECOLORSPACE DeleteColorSpace;

  } else if (recordType == EMR_GLSRECORD) {
    EMRGLSRECORD GlsRecord;

  } else if (recordType == EMR_GLSBOUNDEDRECORD) {
    EMRGLSBOUNDEDRECORD GlsBoundedRecord;

  } else if (recordType == EMR_DRAWESCAPE) {
    EMRDRAWESCAPE DrawEscape;

  } else if (recordType == EMR_EXTESCAPE) {
    EMREXTESCAPE ExtEscape;

  } else if (recordType == EMR_NAMEDESCAPE) {
    EMRNAMEDESCAPE NamedEscape;

  } else if (recordType == EMR_COLORCORRECTPALETTE) {
    EMRCOLORCORRECTPALETTE ColorCorrectPalette;

  //} else if (recordType == 0x7A) {
  //  EMRCREATECOLORSPACEW CreateColorSpaceW;

  } else if (recordType == EMR_ALPHABLEND) {
    EMRALPHABLEND AlphaBlend;

  } else if (recordType == EMR_TRANSPARENTBLT) {
    EMRTRANSPARENTBLT TransparentBlt;

  } else if (recordType == EMR_GRADIENTFILL) {
    EMRGRADIENTFILL GradientFill;

  } else {
    Warning( "Unsupported EMF record type." );
    return -1;
  }

}

// Close EMF records.
EMREOF EmfEndOfFile;

// Fix nBytes member of the EMR_HEADER record.
local int64 file_size = FTell();
Assert(file_size <= 0xFFFFFFFF && (file_size & 3) == 0,
       "EMF file size must fit in the header nBytes DWORD and be a multiple of 4 bytes.");
FSeek(0x30);
local int previousFileSizeEvilState = SetEvilBit(false);
DWORD nBytes = { (DWORD)file_size };
// A final compound item can exceed the original record budget.
FSeek(0x34);
DWORD nRecords = { recCnt + 2 }; // Include EMR_HEADER and EMR_EOF.
SetEvilBit(previousFileSizeEvilState);

// Check file size.
if (file_size % 4 != 0) { // The total size of the record must be a multiple of 4 bytes.
  Warning( "File size is invalid. Template stopped." );
  return -1;
}
