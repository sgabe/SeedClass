/** 2.3.5.7 EMR_EXTTEXTOUTA
 * https://docs.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/6b582a71-3c29-4fc6-a0f4-1f8a313739a1
 */
typedef struct tagEMREXTTEXTOUTA {
  local int64 recordStart = FTell();
  DWORD iType = { 0x00000053 };
  DWORD	nSize;
  RECTL rclBounds;
  DWORD iGraphicsMode;
  FLOAT exScale;
  FLOAT eyScale;
  struct {
    POINT ptlReference;
    DWORD nChars <min=0, max=32>;
    local int offStringPosition = SetEvilBit(false);
    DWORD offString = { 0x0000004C };
    DWORD fOptions = { 0x00000000 };
    SetEvilBit(offStringPosition);
    RECTL rcl;
    local int offDxPosition = SetEvilBit(false);
    DWORD offDx = { (DWORD)(Align4(0x0000004C + nChars)) };
    SetEvilBit(offDxPosition);
  } aEmrText;
  if (aEmrText.nChars) {
    FSeek(recordStart + aEmrText.offString);
    BYTE bStringBuffer[aEmrText.nChars];
    FSeek(recordStart + aEmrText.offDx);
    DWORD OutputDx[aEmrText.nChars];
  }

  local int64 recordSize = FTell() - recordStart;
  local uint paddingSize = Align4(recordSize) - recordSize;
  BYTE EmrAlignmentPadding[paddingSize];
  local int64 recordEnd = FTell();
  AssertValidEmfRecordSize(recordEnd - recordStart);
  FSeek(recordStart + 4);
  local int previousEvilState = SetEvilBit(false);
  DWORD nSize = { (DWORD)(recordEnd - recordStart) };
  SetEvilBit(previousEvilState);
  FSeek(recordEnd);
} EMREXTTEXTOUTA;

/** 2.3.5.8 EMR_EXTTEXTOUTW Record
 * https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/a59a79ac-328e-492d-a34d-e02727af6edf
 */
typedef struct tagEMREXTTEXTOUTW {
  local int64 recordStart = FTell();
  local int previousTextEvilState = SetEvilBit(false);
  DWORD iType = { 0x00000054 };
  DWORD	nSize;
  RECTL rclBounds;
  DWORD iGraphicsMode = { 1 }; // GM_COMPATIBLE.
  // IEEE-754 FLOAT 1.0, encoded as bits for FormatFuzzer's integer-based parser.
  DWORD exScale = { 0x3F800000 };
  DWORD eyScale = { 0x3F800000 };
  struct {
    struct {
      LONG x = { 40 };
      LONG y = { 60 };
    } ptlReference;
    DWORD nChars = { 3 };
    DWORD offString = { 0x0000004C };
    DWORD fOptions = { 0x00000000 };
    RECTL rcl;
    DWORD offDx = { (DWORD)(Align4(0x0000004C + nChars * 2)) };
  } wEmrText;
  if (wEmrText.nChars) {
    FSeek(recordStart + wEmrText.offString);
    // A, Latin small e with acute, and Greek capital omega in UTF-16LE.
    struct {
      WORD LatinA = { 0x0041 };
      WORD LatinEAcute = { 0x00E9 };
      WORD GreekOmega = { 0x03A9 };
    } bStringBuffer;
    WORD StringAlignmentPadding = { 0 };
    FSeek(recordStart + wEmrText.offDx);
    local uint charIndex = 0;
    for (charIndex = 0; charIndex < wEmrText.nChars; charIndex++) {
      DWORD OutputDx = { 12 };
    }
  }

  local int64 recordSize = FTell() - recordStart;
  local uint paddingSize = Align4(recordSize) - recordSize;
  BYTE EmrAlignmentPadding[paddingSize];
  local int64 recordEnd = FTell();
  AssertValidEmfRecordSize(recordEnd - recordStart);
  FSeek(recordStart + 4);
  local int previousEvilState = SetEvilBit(false);
  DWORD nSize = { (DWORD)(recordEnd - recordStart) };
  SetEvilBit(previousEvilState);
  FSeek(recordEnd);
  SetEvilBit(previousTextEvilState);
} EMREXTTEXTOUTW;

