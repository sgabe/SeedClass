// 2.3.4. Control Record Types
//------------------------------------------------

/** 2.3.4.1 EMR_EOF Record
 * https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/3f47fde0-0e6b-40c1-87f3-f4129af03aa1
 */
typedef struct {
  local int64 recordStart = FTell();
  // Keep the terminal record and its empty palette fields valid during generation.
  local int previousEOFEvilState = SetEvilBit(false);
  if (IsParsing()) {
    SetEvilBit(previousEOFEvilState);
  }
  DWORD iType = { 0x0000000E };    // Record type is EMR_EOF.
  DWORD nSize;
  DWORD nPalEntries = { 0 };       // Number of palette entries.
  DWORD offPalEntries = { 0 };     // Offset to the palette entries from the start of this record.
  local int64 sizeLastPosition = FTell();
  DWORD SizeLast;

  // Backpatch Size and SizeLast from the measured DWORD-aligned EOF record length.
  local int64 recordSize = FTell() - recordStart;
  local uint paddingSize = Align4(recordSize) - recordSize;
  BYTE EmrAlignmentPadding[paddingSize];
  local int64 recordEnd = FTell();
  AssertValidEmfRecordSize(recordEnd - recordStart);
  FSeek(recordStart + 4);
  local int previousEvilState = SetEvilBit(false);
  DWORD nSize = { (DWORD)(recordEnd - recordStart) };
  FSeek(sizeLastPosition);
  DWORD SizeLast = { (DWORD)(recordEnd - recordStart) };
  SetEvilBit(previousEvilState);
  FSeek(recordEnd);
  SetEvilBit(previousEOFEvilState);
} EMREOF;

typedef struct tagSIZEL_DEVICE {
  LONG cx = { 0x00000780 };
  LONG cy = { 0x00000780 };
} SIZEL_DEVICE;

typedef struct tagSIZEL_MILLIMETERS {
  LONG cx = { 0x000002A5 };
  LONG cy = { 0x000001A7 };
} SIZEL_MILLIMETERS;

/** 2.3.4.2.1 EMR_HEADER Record
 * https://learn.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/80c0684b-9a0e-4bdb-8d6d-0e5a9e9673e7
 */
typedef struct {
  local int64 recordStart = FTell();
  // Keep required header constants and frame geometry valid during generation.
  local int previousHeaderEvilState = SetEvilBit(false);
  if (IsParsing()) {
    SetEvilBit(previousHeaderEvilState); // Preserve the existing input parsing policy.
  }
  DWORD iType = { 0x00000001 };                        // Record type EMR_HEADER.
  DWORD nSize;
  RECTL rclBounds;                                     // Inclusive-inclusive bounds in device units.
  RECTL rclFrame;                                      // Inclusive-inclusive picture frame of metafile in .01 mm units.
  DWORD dSignature = { 0x464D4520 };                   // EMF
  DWORD nVersion = { 0x00010000 };
  DWORD nBytes = { 0 };                                // Patched with the final metafile size.
  local int previousRecordCountEvilState = SetEvilBit(IsParsing());
  DWORD nRecords <min=3, max=16>;                      // Header + at least one body record + EOF.
  SetEvilBit(previousRecordCountEvilState);
  WORD  nHandles = { 0x0001 };                         // Handle table contains reserved index zero only.
  WORD  sReserved = { 0 };
  DWORD nDescription = { 0 };                          // Number of chars in the unicode description string.
  DWORD offDescription = { 0 };                        // Offset to the metafile description record.
  DWORD nPalEntries = { 0 };                           // Number of entries in the metafile palette.
  SIZEL_DEVICE szlDevice;                              // Size of the reference device in pixels.
  SIZEL_MILLIMETERS szlMillimeters;                    // Size of the reference device in millimeters.
  HeaderExtension1 EmfHeaderExtension1;
  HeaderExtension2 EmfHeaderExtension2;

  local int64 recordSize = FTell() - recordStart;
  local uint paddingSize = Align4(recordSize) - recordSize;
  BYTE EmrAlignmentPadding[paddingSize];
  local int64 recordEnd = FTell();
  AssertValidEmfRecordSize(recordEnd - recordStart);
  FSeek(recordStart + 4);
  local int previousEvilState = SetEvilBit(false);
  DWORD nSize = { (DWORD)(recordEnd - recordStart) };
  SetEvilBit(previousEvilState);
  FSeek(recordEnd);
  SetEvilBit(previousHeaderEvilState); // Restore body generation and parsing policy.
} EMRHEADER;

typedef struct {
  WORD desc[EmfHeader.nDescription - 1];
  WORD terminator = { 0 };
} EMRDESCRIPTION;


