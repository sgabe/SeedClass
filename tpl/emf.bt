/** 2.3.1.7 EMR_STRETCHDIBITS Record
 * https://docs.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/89c0d808-0dea-413f-be40-2e9e51fa36ac
 */
typedef struct tagEMRSTRETCHDIBITS {
  local int64 recordStart = FTell();
  local int previousBitmapEvilState = SetEvilBit(false);
  local uint emrSize = 0x00000050;
  local uint bmiSize = 0x00000028;
  local int bitmapWidth = 3;
  local int bitmapHeight = 2;
  local uint bitmapStride = (uint)Align4(bitmapWidth * 3);
  local uint bitmapBitsSize = bitmapStride * bitmapHeight;

  DWORD iType = { 0x00000051 };
  DWORD	nSize;
  RECTL rclBounds;
  LONG xDest = { 40 };
  LONG yDest = { 60 };
  LONG xSrc = { 0 };
  LONG ySrc = { 0 };
  LONG cxSrc = { bitmapWidth };
  LONG cySrc = { bitmapHeight };
  DWORD offBmiSrc = { emrSize };
  DWORD cbBmiSrc = { bmiSize };
  DWORD offBitsSrc = { emrSize + bmiSize };
  DWORD cbBitsSrc = { bitmapBitsSize };
  DWORD iUsageSrc = { 0 }; // DIB_RGB_COLORS.
  DWORD dwRop = { 0x00CC0020 }; // SRCCOPY requires the source pixels.
  LONG cxDest = { 64 };
  LONG cyDest = { 64 };

  // This 24-bit BI_RGB case has a BITMAPINFOHEADER and no color table.
  FSeek(recordStart + offBmiSrc);
  struct {
    DWORD biSize = { bmiSize };
    LONG biWidth = { bitmapWidth };
    LONG biHeight = { bitmapHeight }; // Positive height: bottom-up rows.
    WORD biPlanes = { 1 };
    WORD biBitCount = { 24 };
    DWORD biCompression = { BI_RGB };
    DWORD biSizeImage = { bitmapBitsSize };
    LONG biXPelsPerMeter = { 0 };
    LONG biYPelsPerMeter = { 0 };
    DWORD biClrUsed = { 0 };
    DWORD biClrImportant = { 0 };
  } bmi;
  Assert(FTell() - recordStart - offBmiSrc == cbBmiSrc,
         "Source bitmap header length must match cbBmiSrc.");

  FSeek(recordStart + offBitsSrc);
  // Each bottom-up row has three BGR pixels followed by three padding bytes.
  UBYTE BitmapBits[bitmapBitsSize];
  Assert(FTell() - recordStart - offBitsSrc == cbBitsSrc,
         "Source pixels and row padding must match cbBitsSrc.");

  local int64 recordSize = FTell() - recordStart;
  local uint paddingSize = Align4(recordSize) - recordSize;
  BYTE EmrAlignmentPadding[paddingSize];
  local int64 recordEnd = FTell();
  AssertValidEmfRecordSize(recordEnd - recordStart);
  FSeek(recordStart + 4);
  local int previousEvilState = SetEvilBit(false);
  DWORD nSize = { (DWORD)(recordEnd - recordStart) };
  SetEvilBit(previousEvilState);
  FSeek(recordEnd);
  SetEvilBit(previousBitmapEvilState);
} EMRSTRETCHDIBITS;

/** 2.3.1.8 EMR_TRANSPARENTBLT Record
 * https://docs.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/aa216051-2dc0-4317-b343-525431cfa103
 */
typedef struct tagEMRTRANSPARENTBLT {
  local int64 recordStart = FTell();
