/** 8.5 EMR_SELECTOBJECT
 * https://docs.microsoft.com/en-us/openspecs/windows_protocols/ms-emf/145b063d-5f96-41fe-b7ae-1e615b2bc2bf
 */
typedef struct tagEMRSELECTOBJECT {
  local int64 recordStart = FTell();
  local int previousStockObjectEvilState = SetEvilBit(IsParsing());
  DWORD iType = { 0x00000025 };
  DWORD	nSize;
  // Predefined pens, brushes, and fonts need no EMF object-table entry.
  // Palettes are selected by EMR_SELECTPALETTE instead.
  DWORD ihObject = {
    WHITE_BRUSH, LTGRAY_BRUSH, GRAY_BRUSH, DKGRAY_BRUSH,
    BLACK_BRUSH, NULL_BRUSH, DC_BRUSH,
    WHITE_PEN, BLACK_PEN, NULL_PEN, DC_PEN,
    OEM_FIXED_FONT, ANSI_FIXED_FONT, ANSI_VAR_FONT, SYSTEM_FONT,
    DEVICE_DEFAULT_FONT, SYSTEM_FIXED_FONT, DEFAULT_GUI_FONT
  };
  SetEvilBit(previousStockObjectEvilState);

  local int64 recordSize = FTell() - recordStart;
  local uint paddingSize = Align4(recordSize) - recordSize;
  BYTE EmrAlignmentPadding[paddingSize];
  local int64 recordEnd = FTell();
  AssertValidEmfRecordSize(recordEnd - recordStart);
  FSeek(recordStart + 4);
  local int previousEvilState = SetEvilBit(false);
  DWORD nSize = { (DWORD)(recordEnd - recordStart) };
  SetEvilBit(previousEvilState);
  FSeek(recordEnd);
} EMRSELECTOBJECT;

